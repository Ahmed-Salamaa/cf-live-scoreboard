# Copy this file to .env and fill in your values.
# Create an API key at https://codeforces.com/settings/api
# For a private contest, the key's owner must be able to see the contest,
# and must be a MANAGER of it to see hidden verdicts during the freeze.

CF_CONTEST_ID=732371
CF_API_KEY=
CF_API_SECRET=

# Use the manager view (unfrozen data). Falls back automatically if the key is not a manager.
CF_AS_MANAGER=true

# Hashed admin password for /admin (generate with: npm run hash-password)
ADMIN_PASSWORD_HASH=

PORT=5173
